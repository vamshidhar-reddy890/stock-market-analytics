# ===================================================================
# Environment Configuration Template (Copy to .env for local use)
# IMPORTANT: NEVER commit real credentials or .env files to GitHub.
# ===================================================================

# Twelve Data Stock API Key
TWELVEDATA_API_KEY=your_twelve_data_api_key

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://your-host:3306/stock_analytics?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=your_database_username
SPRING_DATASOURCE_PASSWORD=your_database_password

# JWT Authentication Signing Secret (at least 256 bits / 32 characters)
JWT_SECRET=your_long_random_jwt_secret

# Server Port (optional, Render provides dynamic PORT)
PORT=9090

# Allowed CORS Origins (comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://YOUR-FRONTEND-NAME.onrender.com

# Frontend API Base URL (used by Vite in frontend/react-project)
VITE_API_BASE_URL=http://localhost:9090/api
